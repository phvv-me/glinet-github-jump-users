#!/bin/ash
set -e
set -f

. /lib/functions.sh
. /lib/functions/network.sh

deny() {
  logger -t github-jump-users "denied user=${LOGNAME:-unknown} source=${SSH_CONNECTION:-unknown} command=${SSH_ORIGINAL_COMMAND:-none}"
  exit 1
}

set -- ${SSH_ORIGINAL_COMMAND:-}
test "$#" -eq 3 || deny
test "$1" = connect || deny

host=$2
port=$3

case "$host" in
  ''|-*|*[!A-Za-z0-9._:%-]*) deny ;;
esac
case "$port" in
  ''|*[!0-9]*) deny ;;
esac
test "$port" -ge 1 2>/dev/null || deny
test "$port" -le 65535 2>/dev/null || deny

lan_devices=
add_lan_device() {
  local device network
  network=$1
  network_get_device device "$network" || return 0
  test -n "$device" && append lan_devices "$device"
  return 0
}

collect_lan_zone() {
  local name section
  section=$1
  config_get name "$section" name
  test "$name" = lan || return 0
  config_list_foreach "$section" network add_lan_device
}

config_load firewall
config_foreach collect_lan_zone zone
test -n "$lan_devices" || deny

case "$host" in
  localhost|localhost.*|0.0.0.0|127.*|::|::1) deny ;;
esac

resolve_addresses() {
  case "$host" in
    *:*) printf '%s\n' "$host" ;;
    *[!0-9.]*)
      nslookup "$host" 127.0.0.1 2>/dev/null | awk '
        /^Name:/ { answer = 1; next }
        answer && /^Address( [0-9]+)?:/ {
          value = $0
          sub(/^Address( [0-9]+)?:[[:space:]]*/, "", value)
          print value
        }
      '
      ;;
    *) printf '%s\n' "$host" ;;
  esac
}

is_router_address() {
  local address candidate
  candidate=$1
  for address in $(ip -o address show 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4 }')
  do
    test "$candidate" != "$address" || return 0
  done
  return 1
}

route_device() {
  local route
  route=$(ip route get "$1" 2>/dev/null) || return 1
  case " $route " in
    *' via '*) return 1 ;;
  esac

  set -- $route
  case "$1" in
    local|broadcast|multicast|unreachable|prohibit|blackhole) return 1 ;;
  esac
  while test "$#" -gt 1
  do
    if test "$1" = dev
    then
      printf '%s\n' "$2"
      return 0
    fi
    shift
  done
  return 1
}

is_lan_device() {
  local device
  for device in $lan_devices
  do
    test "$1" != "$device" || return 0
  done
  return 1
}

select_target() {
  local address device
  for address in $(resolve_addresses)
  do
    is_router_address "$address" && continue
    device=$(route_device "$address") || continue
    is_lan_device "$device" || continue
    printf '%s\n' "$address"
    return 0
  done
  return 1
}

target=$(select_target) || deny

logger -t github-jump-users "connect user=${LOGNAME:-unknown} source=${SSH_CONNECTION:-unknown} target=$host resolved=$target port=$port"
exec nc "$target" "$port"
