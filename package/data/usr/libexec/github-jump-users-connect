#!/bin/ash
set -e
set -f

deny() {
  logger -t github-jump-users "denied user=${LOGNAME:-unknown} source=${SSH_CONNECTION:-unknown} command=${SSH_ORIGINAL_COMMAND:-none}"
  exit 1
}

set -- ${SSH_ORIGINAL_COMMAND:-}
test "$#" -eq 3 || deny
test "$1" = connect || deny

host=$2
port=$3

case "$host" in
  ''|-*|*[!A-Za-z0-9._:%-]*) deny ;;
esac
case "$port" in
  ''|*[!0-9]*) deny ;;
esac
test "$port" -ge 1 2>/dev/null || deny
test "$port" -le 65535 2>/dev/null || deny

lan_devices=br-lan
lan_zone=$(uci -q show firewall 2>/dev/null |
  sed -n "s/^\(firewall\..*\)\.name='lan'$/\1/p" |
  sed -n '1p')

if test -n "$lan_zone"
then
  lan_networks=$(uci -q get "$lan_zone.network" 2>/dev/null || true)
  lan_devices="$lan_devices $(uci -q get "$lan_zone.device" 2>/dev/null || true)"

  for network in $lan_networks
  do
    device=$(uci -q get "network.$network.device" 2>/dev/null || true)
    if test -z "$device"
    then
      device=$(uci -q get "network.$network.ifname" 2>/dev/null || true)
    fi
    if test "$(uci -q get "network.$network.type" 2>/dev/null || true)" = bridge
    then
      device="br-$network $device"
    fi
    lan_devices="$lan_devices $device"
  done
fi

case "$host" in
  localhost|localhost.*|0.0.0.0|127.*|::|::1) deny ;;
esac

resolve_addresses() {
  case "$host" in
    *:*) printf '%s\n' "$host" ;;
    *[!0-9.]*)
      nslookup "$host" 127.0.0.1 2>/dev/null | awk '
        /^Name:/ { answer = 1; next }
        answer && /^Address( [0-9]+)?:/ {
          value = $0
          sub(/^Address( [0-9]+)?:[[:space:]]*/, "", value)
          print value
        }
      '
      ;;
    *) printf '%s\n' "$host" ;;
  esac
}

is_router_address() {
  local address candidate
  candidate=$1
  for address in $(ip -o address show 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4 }')
  do
    test "$candidate" != "$address" || return 0
  done
  return 1
}

route_device() {
  local route
  case "$1" in
    *:*) route=$(ip -6 route get "$1" 2>/dev/null) || return 1 ;;
    *) route=$(ip route get "$1" 2>/dev/null) || return 1 ;;
  esac
  case " $route " in
    *' via '*) return 1 ;;
  esac

  set -- $route
  case "$1" in
    local|broadcast|multicast|unreachable|prohibit|blackhole) return 1 ;;
  esac
  while test "$#" -gt 1
  do
    if test "$1" = dev
    then
      printf '%s\n' "$2"
      return 0
    fi
    shift
  done
  return 1
}

is_lan_device() {
  local device
  for device in $lan_devices
  do
    test "$1" != "$device" || return 0
  done
  return 1
}

select_target() {
  local address device
  for address in $(resolve_addresses)
  do
    is_router_address "$address" && continue
    device=$(route_device "$address") || continue
    is_lan_device "$device" || continue
    printf '%s\n' "$address"
    return 0
  done
  return 1
}

target=$(select_target) || deny

logger -t github-jump-users "connect user=${LOGNAME:-unknown} source=${SSH_CONNECTION:-unknown} target=$host resolved=$target port=$port"
exec nc "$target" "$port"
