#!/bin/sh
set -e

. /lib/functions.sh

grep -q '^jumpusers:' /etc/group || addgroup jumpusers

setup_account() {
  local section username managed key_file gid
  section=$1
  config_get username "$section" username
  config_get managed "$section" managed 0
  config_get key_file "$section" key_file
  test "$managed" = 1 || return 0

  if ! id "$username" >/dev/null 2>&1
  then
    adduser -D -G jumpusers -h "/home/$username" -s /bin/ash \
      -g "Restricted SSH jump account" "$username"
  else
    addgroup "$username" jumpusers >/dev/null 2>&1 || true
  fi

  passwd -l "$username" >/dev/null 2>&1 || true
  mkdir -p "$(dirname "$key_file")"
  test -e "$key_file" || touch "$key_file"
  chown root:root "/home/$username" "$(dirname "$key_file")"
  gid=$(id -g "$username")
  chown "root:$gid" "$key_file"
  chmod 755 "/home/$username" "$(dirname "$key_file")"
  chmod 640 "$key_file"
}

remove_legacy_member_options() {
  local section
  section=$1
  uci -q delete "github-jump-users.$section.target_user" || true
  uci -q delete "github-jump-users.$section.identity_file" || true
}

config_load github-jump-users
config_foreach setup_account account
config_foreach remove_legacy_member_options member
uci commit github-jump-users

echo SETUP_OK
