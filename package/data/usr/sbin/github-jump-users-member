#!/bin/sh
set -e

. /lib/functions.sh

action=${1:-}
account=${2:-}
github=${3:-}
target_user=${4:-}
identity_file=${5:-}
account_section=
member_section=
member_github=
account_mode=
key_file=

find_account() {
  local section existing
  section=$1
  config_get existing "$section" username
  if test "$existing" = "$account"
  then
    account_section=$section
  fi
  return 0
}

find_member() {
  local section existing_account existing_github
  section=$1
  config_get existing_account "$section" account
  config_get existing_github "$section" github
  if test "$existing_account" = "$account" && \
    test "$(printf '%s' "$existing_github" | tr 'A-Z' 'a-z')" = \
      "$(printf '%s' "$github" | tr 'A-Z' 'a-z')"
  then
    member_section=$section
    member_github=$existing_github
  fi
  return 0
}

config_load github-jump-users
config_foreach find_account account
test -n "$account_section" || {
  echo "router account is not configured" >&2
  exit 3
}
config_get account_mode "$account_section" mode
config_get key_file "$account_section" key_file
config_foreach find_member member

case "$action" in
  add)
    test -z "$member_section" || {
      echo "GitHub user is already assigned to this account" >&2
      exit 3
    }
    case "$github" in
      ''|-*|*-|*--*|*[!A-Za-z0-9-]*) echo "invalid GitHub username" >&2; exit 2 ;;
    esac
    test "${#github}" -le 39 || {
      echo "invalid GitHub username" >&2
      exit 2
    }
    case "$target_user" in
      ''|*[!A-Za-z0-9._-]*) echo "invalid target SSH username" >&2; exit 2 ;;
    esac
    test "${#target_user}" -le 64 || {
      echo "invalid target SSH username" >&2
      exit 2
    }
    case "$identity_file" in
      ''|*[!A-Za-z0-9_./~@+-]*) echo "invalid identity file path" >&2; exit 2 ;;
    esac
    test "${#identity_file}" -le 200 || {
      echo "invalid identity file path" >&2
      exit 2
    }

    /usr/bin/github-authorized-keys jump validation "$github" >/dev/null

    section=$(uci add github-jump-users member)
    uci set "github-jump-users.$section.account=$account"
    uci set "github-jump-users.$section.github=$github"
    uci set "github-jump-users.$section.target_user=$target_user"
    uci set "github-jump-users.$section.identity_file=$identity_file"
    uci commit github-jump-users

    if ! /usr/sbin/github-jump-users-sync "$account" >/dev/null
    then
      uci -q delete "github-jump-users.$section"
      uci commit github-jump-users
      echo "could not activate GitHub keys" >&2
      exit 4
    fi
    echo ADD_OK
    ;;
  remove)
    test -n "$member_section" || {
      echo "GitHub user is not assigned to this account" >&2
      exit 3
    }
    tempfile="$key_file.new.$$"
    trap 'rm -f "$tempfile"' EXIT HUP INT TERM
    awk -v marker="gjju-$account-$member_github" '$NF != marker' "$key_file" > "$tempfile"
    if test "$account_mode" = admin
    then
      chown root:root "$tempfile"
      chmod 600 "$tempfile"
    else
      chown "root:$(id -g "$account")" "$tempfile"
      chmod 640 "$tempfile"
    fi
    mv "$tempfile" "$key_file"
    trap - EXIT HUP INT TERM
    uci -q delete "github-jump-users.$member_section"
    uci commit github-jump-users
    echo REMOVE_OK
    ;;
  *)
    echo "usage: github-jump-users-member add ACCOUNT GITHUB TARGET_USER IDENTITY_FILE | remove ACCOUNT GITHUB" >&2
    exit 2
    ;;
esac
