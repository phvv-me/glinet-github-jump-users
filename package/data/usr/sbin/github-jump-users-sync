#!/bin/sh
set -e

. /lib/functions.sh

requested=${1:-all}
failed=

sync_account() {
  local section username mode key_file members marker tempfile unmanaged managed
  section=$1
  config_get username "$section" username
  config_get mode "$section" mode
  config_get key_file "$section" key_file

  test "$requested" = all || test "$requested" = "$username" || return 0
  test -n "$username"
  test -n "$key_file"

  members=
  collect_member() {
    local member member_account github
    member=$1
    config_get member_account "$member" account
    config_get github "$member" github
    if test "$member_account" = "$username"
    then
      members="$members $github"
    fi
    return 0
  }
  config_foreach collect_member member

  tempfile="$key_file.new.$$"
  unmanaged="$key_file.unmanaged.$$"
  managed="$key_file.managed.$$"
  marker="gjju-$username-"
  mkdir -p "$(dirname "$key_file")"
  test -e "$key_file" || touch "$key_file"
  awk -v marker="$marker" 'index($NF, marker) != 1' "$key_file" > "$unmanaged"

  if test -n "$members"
  then
    set -- $members
    if ! /usr/bin/github-authorized-keys "$mode" "$username" "$@" > "$managed"
    then
      rm -f "$tempfile" "$unmanaged" "$managed"
      failed="$failed $username"
      return 0
    fi
  else
    : > "$managed"
  fi

  awk '
    function key_id(   field) {
      for (field = 1; field < NF; field++) {
        if ($field ~ /^(ssh-rsa|ssh-ed25519|ecdsa-sha2-nistp256|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)$/) {
          return $field " " $(field + 1)
        }
      }
      return $0
    }
    NF && !seen[key_id()]++
  ' "$managed" "$unmanaged" > "$tempfile"
  if test "$mode" = admin
  then
    chown root:root "$tempfile"
    chmod 600 "$tempfile"
  else
    gid=$(id -g "$username")
    chown "root:$gid" "$tempfile"
    chmod 640 "$tempfile"
  fi
  mv "$tempfile" "$key_file"
  rm -f "$unmanaged" "$managed"
}

config_load github-jump-users
config_foreach sync_account account

test -z "$failed" || {
  echo "could not synchronize$failed" >&2
  exit 1
}

echo SYNC_OK
