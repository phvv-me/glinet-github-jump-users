config settings 'main'
  option endpoint 'router.example.com'
  option ssh_port '22'
  option target_policy 'any'

config account 'root'
  option username 'root'
  option label 'Root administrator'
  option mode 'admin'
  option managed '0'
  option created '0'
  option key_file '/etc/dropbear/authorized_keys'

config account 'jump'
  option username 'jump'
  option label 'Shared jump account'
  option mode 'jump'
  option managed '1'
  option created '0'
  option key_file '/home/jump/.ssh/authorized_keys'
